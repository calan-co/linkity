{
  "scopeName": "markdown.wikilink.injection",
  "injectionSelector": "L:text.html.markdown",
  "patterns": [
    {
      "include": "#wikilink"
    }
  ],
  "repository": {
    "wikilink": {
      "patterns": [
        {
          "name": "markup.underline.link.wikilink.markdown",
          "match": "(\\[\\[)([^\\[\\]#\\|]+)(?:(#)([^\\[\\]\\|]+))?(?:(\\|)([^\\[\\]]+))?(\\]\\])",
          "captures": {
            "1": {
              "name": "punctuation.definition.link.begin.wikilink.markdown"
            },
            "2": {
              "name": "entity.name.tag.wikilink.target.markdown"
            },
            "3": {
              "name": "punctuation.definition.anchor.wikilink.markdown"
            },
            "4": {
              "name": "entity.name.tag.wikilink.anchor.markdown"
            },
            "5": {
              "name": "punctuation.separator.wikilink.markdown"
            },
            "6": {
              "name": "string.other.link.title.wikilink.markdown"
            },
            "7": {
              "name": "punctuation.definition.link.end.wikilink.markdown"
            }
          }
        }
      ]
    }
  }
}
