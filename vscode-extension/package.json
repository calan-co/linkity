{
  "name": "vscode-linkity",
  "displayName": "Linkity for VS Code",
  "description": "Complete wikilink support powered by linkity - navigation, backlinks, graph visualization, and reference generation",
  "version": "0.1.0",
  "publisher": "linkity",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Formatters",
    "Other"
  ],
  "keywords": [
    "wikilinks",
    "obsidian",
    "foam",
    "markdown",
    "knowledge-graph",
    "backlinks"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Linkity",
      "properties": {
        "linkity.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable wikilinks support"
        },
        "linkity.rootFolder": {
          "type": "string",
          "default": "./",
          "description": "Root folder for link resolution"
        },
        "linkity.linkResolution": {
          "type": "string",
          "enum": [
            "firstMatch",
            "mostSpecific",
            "interactive"
          ],
          "default": "mostSpecific",
          "description": "Strategy for resolving ambiguous links"
        },
        "linkity.autoGenerateReferences": {
          "type": "boolean",
          "default": false,
          "description": "Auto-generate reference definitions on save"
        },
        "linkity.referenceFormat": {
          "type": "string",
          "enum": [
            "markdown",
            "inline"
          ],
          "default": "markdown",
          "description": "Format for generated references"
        },
        "linkity.enableBacklinks": {
          "type": "boolean",
          "default": true,
          "description": "Enable backlinks panel"
        },
        "linkity.enableGraph": {
          "type": "boolean",
          "default": true,
          "description": "Enable graph visualization"
        },
        "linkity.excludePatterns": {
          "type": "array",
          "default": [
            "node_modules",
            ".git",
            "dist"
          ],
          "description": "Glob patterns to exclude from indexing"
        },
        "linkity.validationSeverity": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "info",
            "hint"
          ],
          "default": "warning",
          "description": "Severity level for broken link diagnostics"
        }
      }
    },
    "commands": [
      {
        "command": "linkity.generateReferences",
        "title": "Linkity: Generate Reference Definitions"
      },
      {
        "command": "linkity.showBacklinks",
        "title": "Linkity: Show Backlinks Panel"
      },
      {
        "command": "linkity.showGraph",
        "title": "Linkity: Show Knowledge Graph"
      },
      {
        "command": "linkity.rebuildIndex",
        "title": "Linkity: Rebuild Workspace Index"
      },
      {
        "command": "linkity.validateLinks",
        "title": "Linkity: Validate All Links"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "linkity.backlinks",
          "name": "Backlinks",
          "when": "linkity.enabled"
        }
      ],
      "wikilinks-graph": [
        {
          "id": "linkity.graphView",
          "name": "Knowledge Graph",
          "when": "linkity.graphVisible"
        }
      ]
    },
    "viewsContainers": {
      "sidebar": [
        {
          "id": "linkity",
          "title": "Linkity",
          "icon": "$(symbol-structure)"
        }
      ]
    },
    "grammars": [
      {
        "scopeName": "markdown.wikilink.injection",
        "path": "./syntaxes/wikilink.injection.json",
        "injectTo": [
          "text.html.markdown"
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node18",
    "watch": "npm run compile -- --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext ts",
    "format": "prettier --write 'src/**/*.ts'"
  },
  "dependencies": {
    "linkity": "file:../linkity",
    "minimatch": "^9.0.3"
  },
  "devDependencies": {
    "@types/node": "^18.x",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vscode/test-electron": "^2.3.8",
    "esbuild": "^0.19.11",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  }
}
